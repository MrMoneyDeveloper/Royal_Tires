APP_USERNAME=
APP_PASSWORD=
DATABASE_URL=sqlite:///./asset_requests.db
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Generate/store a long random server-side value. It encrypts the Zendesk API token in SQL.
# Zendesk domain/email/token are entered through the authenticated setup wizard, not Render env vars.
CONFIG_ENCRYPTION_KEY=

# Reserved for the later Zendesk -> FastAPI webhook phase.
ZENDESK_WEBHOOK_SECRET=
